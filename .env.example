# ---------------------------------------------------------------------------
# SetMyFit — new stack: Firebase Auth + Cloudflare D1 + Cloudflare R2
# ---------------------------------------------------------------------------

# --- Firebase client (public, NEXT_PUBLIC_*) ---
# These values ALSO ship inside the client JS bundle, so they can come from
# build-time env (.env.production) OR plain runtime Variables on the host:
# the browser falls back to GET /api/config/firebase, which reads live
# server env. Either way, a rebuild/redeploy picks up changes.
# From Firebase Console > Project settings > General > Your apps > SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# --- Firebase Admin (server, secret) ---
# From Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com"
# Private key with literal \n newlines (single line):
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Cloudflare D1 (server) ---
# wrangler d1 create setmyfit-db  -> fills CLOUDFLARE_D1_DATABASE_ID
# API token: Cloudflare dashboard > My Profile > API Tokens > D1 (read/write)
#  - or: wrangler pages dev (bindings) - not required, REST is used instead
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_D1_DATABASE_ID=""
CLOUDFLARE_API_TOKEN=""
# NOTE: for zero-config LOCAL dev, omit the three vars above to use .data/local.db (SQLite).

# --- Cloudflare R2 image storage (server + public URL) ---
# 1. wrangler r2 bucket create setmyfit-images
# 2. R2 > bucket > Settings > Public access > Allow Access (r2.dev) or Custom Domain
# 3. R2 > Manage R2 API Tokens > create token with Object Read & Write
R2_BUCKET="setmyfit-images"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxx.r2.dev"
# Optional public mirror for next/image (client):
NEXT_PUBLIC_R2_PUBLIC_URL="https://pub-xxxxxxxxxxxx.r2.dev"
CLOUDFLARE_ACCOUNT_ID="" # (same as above)
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# --- AI / Weather (unchanged) ---
# Get API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Get API key from https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here
